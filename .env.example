# ==============================================================================
# LogShield Environment Configuration
# ==============================================================================

# Application environment: development | staging | production
APP_ENV=development

# Execution Mode:
#   local     - Standalone laptop mode (Python / Local PySpark / Local Parquet)
#   hadoop    - Distributed Hadoop HDFS + Apache Spark Cluster mode
#   streaming - Real-time Kafka + PySpark Structured Streaming mode
MODE=local

# Storage Paths
DATA_ROOT=./data
RAW_LOG_PATH=./data/raw/server.log
QUARANTINE_PATH=./data/quarantine

# Apache Hadoop HDFS Integration
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_LOG_PATH=/logs/server.log

# Apache Kafka Integration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=logs
KAFKA_CONSUMER_GROUP=logshield-stream-group

# Apache PySpark Sizing & Performance Tuning
SPARK_APP_NAME=LogShield-Analytics
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=10

# FastAPI REST Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Web Dashboard Port
DASHBOARD_PORT=8080

# Logging & Telemetry
LOG_LEVEL=INFO
